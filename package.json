{
  "name": "@cinatra-ai/blog-draft-writer-agent",
  "version": "0.2.0",
  "files": [
    "cinatra"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "test": "sh -c \"node --test\""
  },
  "description": "Stateless leaf agent that takes ONE plain-text idea and writes a blog draft (title, excerpt, markdown content, sources used, notes). The host files the content as a @cinatra-ai/blog-post-artifact through the declarative EndNode binding. The person sees one field: the idea.",
  "type": "module",
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Blog Draft Writer Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/blog-idea-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/blog-post-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/context-selection-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.1"
        },
        "requirement": "required",
        "kind": "agent"
      }
    ],
    "consumes": [],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "blog-draft-writer-agent-flow",
    "sourceVersionId": "8bf00702-a2f1-4a3b-8422-10bc36e16d24",
    "sourceVersionNumber": 1,
    "type": "flow",
    "riskLevel": "low",
    "hasApprovalGates": true,
    "toolAccess": [],
    "ownerOrgId": null,
    "agentDependencies": {
      "@cinatra-ai/context-selection-agent": "^0.1.1"
    },
    "produces": [
      {
        "extension": "@cinatra-ai/blog-post-artifact",
        "objectTypeId": "@cinatra-ai/blog-post-artifact:post"
      }
    ]
  }
}
